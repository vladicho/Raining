{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raining",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-19",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/webhook",
      "/api/*"
    ]
  },
  "vars": {
    "WHATSAPP_API_VERSION": "v24.0"
  },
  "routes": [
    {
      "pattern": "raining.lugarerrado.com",
      "custom_domain": true
    }
  ]
}
